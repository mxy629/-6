# 服务端配置
PORT=3000
NODE_ENV=development

# JWT 配置（生产环境请更换为足够长的随机字符串）
JWT_SECRET=growth-planet-dev-secret-change-me
JWT_EXPIRES_IN=7d

# 数据库配置
# 开发阶段默认使用 SQLite，方便本地直接运行；生产请切换为 MySQL
DATABASE_URL="file:./dev.db"

# 微信小程序配置（上线前填写真实信息）
WECHAT_APPID=
WECHAT_SECRET=

# 上传配置（开发阶段可留空，使用前端直链或本地 mock）
UPLOAD_ENDPOINT=
UPLOAD_BUCKET=
