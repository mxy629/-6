.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-badge.sm {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
}

.status-badge.md {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
}

.status-badge.lg {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}
