.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  background: var(--color-surface);
  border-radius: 24rpx;
  border: 1rpx solid var(--color-border);
  margin-bottom: 24rpx;
}

.empty-emoji {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.empty-text {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
  line-height: 1.5;
}

.empty-action {
  display: inline-block;
  margin-top: 24rpx;
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: 26rpx;
  font-weight: 500;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(52, 179, 104, 0.2);
}
