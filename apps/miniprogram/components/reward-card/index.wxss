.reward-card {
  position: relative;
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 20rpx;
  width: calc(50% - 12rpx);
  box-sizing: border-box;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid var(--color-border);
  overflow: hidden;
}

.rc-img,
.rc-img--ph {
  width: 100%;
  height: 180rpx;
  border-radius: 18rpx;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.rc-body {
  padding-top: 16rpx;
}

.rc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rc-cost {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-warning);
  margin-top: 10rpx;
  display: flex;
  align-items: center;
}

.rc-star {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.rc-tip {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

.rc-tip--ok {
  color: var(--color-primary);
  font-weight: 500;
}

.rc-btn {
  margin-top: 14rpx;
  background: var(--color-primary);
  color: var(--color-surface);
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  padding: 14rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(52, 179, 104, 0.18);
}

.rc-goal {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  background: rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  z-index: 2;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.rc-goal.on {
  color: var(--color-surface);
  background: var(--color-warning);
}
