.task-card {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid var(--color-border);
  transition: transform 0.15s ease;
}

.task-card:active {
  transform: scale(0.99);
}

.task-card--compact {
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.tc-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.task-card--compact .tc-icon {
  width: 64rpx;
  height: 64rpx;
  font-size: 32rpx;
}

.tc-body {
  flex: 1;
  min-width: 0;
}

.tc-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.tc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  flex: 1;
  margin-right: 12rpx;
}

.tc-points {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-warning);
  flex-shrink: 0;
}

.tc-points-star {
  font-size: 22rpx;
}

.tc-meta {
  margin-bottom: 12rpx;
}

.tc-meta-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.tc-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tc-status {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tc-action {
  background: var(--color-primary);
  color: var(--color-surface);
  font-size: 24rpx;
  font-weight: 500;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(52, 179, 104, 0.2);
}

.tc-action:active {
  opacity: 0.9;
  transform: scale(0.96);
}
