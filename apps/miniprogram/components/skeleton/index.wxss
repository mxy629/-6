.skeleton-wrap {
  padding: 8rpx 0;
}

.skeleton-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border);
}

.skeleton-row {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
}

.sk-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-divider);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.sk-body {
  flex: 1;
}

.sk-line {
  height: 24rpx;
  background: var(--color-divider);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  width: 70%;
}

.sk-line-sm {
  width: 40%;
  margin-bottom: 0;
}

.sk-line-lg {
  width: 50%;
}
