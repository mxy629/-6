<view wx:if="{{show}}" class="skeleton-wrap">
  <view wx:if="{{type === 'card'}}" class="skeleton-card">
    <view class="sk-line sk-line-lg"></view>
    <view class="sk-line"></view>
    <view class="sk-line sk-line-sm"></view>
  </view>
  <block wx:else>
    <view class="skeleton-row" wx:for="{{rows}}" wx:key="*this">
      <view class="sk-avatar"></view>
      <view class="sk-body">
        <view class="sk-line"></view>
        <view class="sk-line sk-line-sm"></view>
      </view>
    </view>
  </block>
</view>
