.loading {
  padding: 60rpx 0;
  text-align: center;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  margin: 0 auto;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  margin-top: 16rpx;
  color: var(--color-text-tertiary);
  font-size: 26rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* skeleton */
.skeleton-row {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
}

.sk-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-divider);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.sk-body {
  flex: 1;
}

.sk-line {
  height: 24rpx;
  background: var(--color-divider);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  width: 70%;
}

.sk-line-sm {
  width: 40%;
  margin-bottom: 0;
}
