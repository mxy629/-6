.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.t-title {
  font-size: 34rpx;
  font-weight: 700;
}

.meta {
  margin-top: 12rpx;
  color: var(--color-warning);
  font-size: 26rpx;
}

.reject {
  background: var(--color-danger-light);
}

.reject-title {
  color: var(--color-danger);
  font-weight: 600;
  font-size: 28rpx;
}

.reject-text {
  margin-top: 8rpx;
  color: var(--color-danger-dark);
  font-size: 26rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  margin: 16rpx 0 12rpx;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background: var(--color-bg);
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.imgs {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.img-item,
.img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  position: relative;
}

.img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--color-danger);
  color: var(--color-surface);
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 28rpx;
}

.img-add {
  border: 2rpx dashed var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-border);
  font-size: 60rpx;
}
