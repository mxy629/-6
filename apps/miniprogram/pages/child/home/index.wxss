.child-page {
  padding-top: 16rpx;
}

.child-greeting {
  margin-bottom: 24rpx;
}

.cg-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.cg-sub {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* 目标奖励 */
.goal-card {
  background: var(--color-surface);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid var(--color-border);
}

.goal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.goal-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.goal-label text {
  margin-left: 8rpx;
}

.goal-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.goal-progress-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.goal-nums {
  display: flex;
  align-items: baseline;
}

.goal-current {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-warning);
}

.goal-split {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  margin: 0 6rpx;
}

.goal-total {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.goal-unit {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-left: 6rpx;
}

.goal-remain {
  font-size: 24rpx;
  color: var(--color-warning);
  font-weight: 500;
}

.goal-bar {
  background: var(--color-warning-light);
}

.goal-bar .progress-fill {
  background: linear-gradient(90deg, var(--color-points) 0%, var(--color-warning) 100%);
}

/* 奖励中心入口 */
.reward-entry {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid var(--color-border);
}

.reward-entry:active {
  opacity: 0.95;
}

.re-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: var(--color-warning-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.re-body {
  flex: 1;
  min-width: 0;
}

.re-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.re-sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
}

.re-arrow {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
  margin-left: 16rpx;
}

/* 时间线 */
.timeline-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border);
}

.tl-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.tl-item:last-child {
  border-bottom: none;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  margin-right: 20rpx;
  background: var(--color-border);
  flex-shrink: 0;
}

.tl-dot.APPROVED,
.tl-dot.FULFILLED {
  background: var(--color-primary);
}

.tl-dot.REJECTED {
  background: var(--color-danger);
}

.tl-dot.PENDING,
.tl-dot.SUBMITTED {
  background: var(--color-warning);
}

.tl-body {
  flex: 1;
}

.tl-text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.4;
}

.tl-time {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
}
