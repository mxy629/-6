.profile-head {
  text-align: center;
  padding: 40rpx 0;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin: 0 auto;
}

.nick {
  font-size: 38rpx;
  font-weight: 700;
  margin: 16rpx 0 8rpx;
}

.stats {
  display: flex;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.btn-logout {
  margin-top: 40rpx;
  background: var(--color-surface);
  color: var(--color-danger);
  border-radius: 24rpx;
}
