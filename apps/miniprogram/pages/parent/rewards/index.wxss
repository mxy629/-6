.filters {
  margin-bottom: 20rpx;
}

.search-wrap {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--color-border);
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  min-height: 48rpx;
  line-height: 48rpx;
}

.status-scroll {
  white-space: nowrap;
}

.chip {
  display: inline-block;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  border: 1rpx solid var(--color-border);
}

.chip-active {
  background: var(--color-primary);
  color: var(--color-surface);
  border-color: var(--color-primary);
}

.form-card {
  padding: 32rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}

.form-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.form-body .input {
  margin-bottom: 0;
}

.inline-row {
  display: flex;
  gap: 20rpx;
}

.inline-row .input {
  flex: 1;
}

.form-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 32rpx;
}

.reward-list {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--color-border);
}

.rw-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.rw-item:last-child {
  border-bottom: none;
}

.rw-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--color-warning-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.rw-body {
  flex: 1;
  min-width: 0;
}

.rw-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.rw-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}

.rw-meta {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.rw-actions {
  display: flex;
  gap: 20rpx;
  margin-left: 16rpx;
  font-size: 24rpx;
}

.rw-edit {
  color: var(--color-primary);
}

.rw-del {
  color: var(--color-danger);
}

.rw-pub {
  color: var(--color-warning);
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(152rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 50;
}

.fab-reward {
  background: linear-gradient(135deg, var(--color-points) 0%, var(--color-warning) 100%);
}

.fab:active {
  transform: scale(0.95);
}
