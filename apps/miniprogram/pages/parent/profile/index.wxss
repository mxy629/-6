.profile-head {
  text-align: center;
  padding: 30rpx 0 40rpx;
}

.avatar-lg {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  margin: 0 auto;
  display: block;
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
}

.nick {
  font-size: 38rpx;
  font-weight: 700;
  margin-top: 16rpx;
  color: var(--color-text-primary);
}

.role-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 999rpx;
}

.action-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.action-card:active {
  opacity: 0.95;
}

.action-text {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.action-arrow {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

.child-list-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border);
}

.ch-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.ch-item:last-child {
  border-bottom: none;
}

.ch-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  margin-right: 18rpx;
  flex-shrink: 0;
}

.ch-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.ch-body {
  flex: 1;
  min-width: 0;
}

.ch-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.ch-meta {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
}

.ch-actions {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
}

.ch-edit {
  color: var(--color-primary);
}

.ch-del {
  color: var(--color-danger);
}

.form-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.form-card .input {
  margin-bottom: 16rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
}

.btn-block {
  margin-bottom: 20rpx;
}
