.pending-badge {
  display: inline-flex;
  align-items: center;
  background: var(--color-warning-light);
  color: var(--color-warning);
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}

.pb-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-warning);
  margin-right: 10rpx;
}

.review-card {
  background: var(--color-surface);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid var(--color-border);
}

.rv-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.rv-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rv-default {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.rv-meta {
  flex: 1;
  min-width: 0;
}

.rv-child {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.rv-time {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.rv-points {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-warning);
  flex-shrink: 0;
}

.rv-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.rv-proof {
  background: var(--color-bg);
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.rv-proof-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 10rpx;
}

.rv-text {
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.rv-imgs {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.rv-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--color-border);
}

.rv-actions {
  display: flex;
  gap: 20rpx;
}

.rv-actions .btn {
  flex: 1;
}
