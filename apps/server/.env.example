# ===== 基础 =====
PORT=3000
NODE_ENV=development
JWT_SECRET=growth-planet-dev-secret-change-me
JWT_EXPIRES_IN=7d

# 开发用 SQLite；生产改为 MySQL，例如：
# DATABASE_URL="mysql://user:pass@host:3306/growth_planet"

# ===== 微信登录（开发期留空走 mock，openid = dev_openid_<code>） =====
WECHAT_APPID=
WECHAT_SECRET=

# ===== 对象存储（孩子提交图片，上架前置） =====
UPLOAD_ENDPOINT=
UPLOAD_BUCKET=

# ===== 短信服务 =====
# 可选值：mock（默认，验证码直接返回，开发期可用） | tencent（腾讯云真实短信）
SMS_PROVIDER=mock
# 以下变量仅在 SMS_PROVIDER=tencent 时必填，缺失将启动即报错：
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN=
SMS_TEMPLATE_ID=
SMS_REGION=ap-guangzhou
