{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": true,
    "strictPropertyInitialization": false,
    "baseUrl": ".",
    "paths": {
      "@growth-planet/shared": ["../../packages/shared/src"],
      "@growth-planet/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
